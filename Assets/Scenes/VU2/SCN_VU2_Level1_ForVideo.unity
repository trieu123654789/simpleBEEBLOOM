    - target: {fileID: 8881028038475493880, guid: fd28f23af44f73f4a95e33435872ad15,
        type: 3}
      propertyPath: m_Text
      value: "C\xE2y c\u1EE7 d\u1EC1n (t\xEAn khoa h\u1ECDc: Beta vulgaris) l\xE0
        m\u1ED9t lo\u1EA1i c\xE2y thu\u1ED9c h\u1ECD Rau mu\u1ED1i (Amaranthaceae),
        \u0111\u01B0\u1EE3c tr\u1ED3ng ph\u1ED5 bi\u1EBFn tr\xEAn th\u1EBF gi\u1EDBi
        nh\u1EDD gi\xE1 tr\u1ECB dinh d\u01B0\u1EE1ng v\xE0 d\u01B0\u1EE3c t\xEDnh.
        \u1EDE Vi\u1EC7t Nam, c\u1EE7 d\u1EC1n th\u01B0\u1EDDng \u0111\u01B0\u1EE3c
        bi\u1EBFt \u0111\u1EBFn v\u1EDBi m\xE0u \u0111\u1ECF t\xEDm \u0111\u1EB7c
        tr\u01B0ng, \u0111\u01B0\u1EE3c d\xF9ng trong \u1EA9m th\u1EF1c v\xE0 y h\u1ECDc
        d\xE2n gian."
      objectReference: {fileID: 0}
